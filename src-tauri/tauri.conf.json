{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sine",
  "mainBinaryName": "mbsine",
  "version": "../package.json",
  "identifier": "com.mattbarr.mbsine",
  "build": {
    "beforeBuildCommand": "node tools/build-offline.js . dist/app/index.html",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sine",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Matt Barr",
    "shortDescription": "Sine machining calculator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-side.bmp",
        "template": "windows/installer.nsi",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "resources": {
      "../fonts/OFL.txt": "fonts/OFL.txt"
    }
  }
}
